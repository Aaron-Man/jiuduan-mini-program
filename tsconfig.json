{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "allowJs": true,
        "skipLibCheck": true,
        "types": ["@dcloudio/types"],
        "paths": {
            "@/*": ["./*"]
        },
        "lib": ["esnext", "dom"]
    },
    "include": ["**/*.js", "**/*.vue"],
    "exclude": ["node_modules", "unpackage", "dist"]
}
