{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "allowJs": true,
        "skipLibCheck": true,
        "types": ["@dcloudio/types"],
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["esnext", "dom"]
    },
    "include": ["src/**/*.js", "src/**/*.vue", "cloud/**/*.js"],
    "exclude": ["node_modules", "unpackage", "dist"]
}
